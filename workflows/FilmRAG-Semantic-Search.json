      "name": "Generate Question Embedding"
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json.data;\n\nconst fields = result.fields;\nconst values = result.values;\n\nconst movies = values.map(row => {\n  const movie = Object.fromEntries(\n    fields.map((field, index) => [field, row[index]])\n  );\n\n  return ` ${movie.title} (${movie.year})\n\n${movie.description}\n\nRelevansscore: ${Number(movie.score).toFixed(3)}`;\n});\n\nreturn [\n  {\n    json: {\n      answer: movies.join(\"\\n\\n--------------------\\n\\n\")\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
