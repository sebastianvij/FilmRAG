        "jsonBody": "={{\n  {\n    statement: \"CALL db.index.vector.queryNodes('movie_embedding', 3, $embedding) YIELD node, score RETURN node.title AS title, node.year AS year, node.description AS description, score ORDER BY score DESC\",\n    parameters: {\n      embedding: $json.embeddings[0]\n    }\n  }\n}}",
